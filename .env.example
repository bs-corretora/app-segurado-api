# Copie para .env e preencha. Nunca faça commit do .env.
# Valores locais: rode `supabase status` depois de `supabase start`.

# Na sua máquina (npm run dev): http://127.0.0.1:54321
# No docker compose, o compose troca para http://host.docker.internal:54321
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Só se o projeto usar segredo HS256 (não usado com chaves assimétricas/JWKS)
SUPABASE_JWT_SECRET=

# Origens do painel/página pública, separadas por vírgula. "*" não é aceito.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# false apenas em desenvolvimento local sobre HTTP
COOKIE_SECURE=false

# Autenticação de POST /api/v1/internal/push/pendentes (Etapa 6), no mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vazio: a rota responde 401 para qualquer chamada.
INTERNAL_API_KEY=

# Endpoint do Expo Push. Deixe vazio (usa https://exp.host/--/api/v2/push/send); só muda em teste.
EXPO_PUSH_URL=

# Endereço público da API e da página de indicação, sem barra no fim (ex.: https://api.exemplo.com.br).
# Usado no link de GET /indicacoes/link. Vazio: usa o endereço da requisição (serve no localhost).
PUBLIC_BASE_URL=
# Swagger em /api/docs. Vazio: ligado no `npm run dev`, desligado em produção.
# No docker compose local (NODE_ENV=production), use true para a demonstração.
API_DOCS=
